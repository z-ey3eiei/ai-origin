{
  "name": "ai-origin",
  "packageManager": "pnpm@10.34.3",
  "version": "1.1.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:api": "node tests/api-smoke.mjs",
    "lint": "tsc --noEmit",
    "format": "prettier --write app components/platform lib next.config.ts sst.config.ts open-next.config.ts proxy.ts vite.config.ts cloudflare.config.ts package.json tsconfig.json",
    "deploy:aws": "sst deploy",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.128",
    "@ai-sdk/react": "^4.0.161",
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@aws-sdk/client-dynamodb": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/credential-providers": "^3.1160.0",
    "@aws-sdk/lib-dynamodb": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@mux/mux-player-react": "^3.14.1",
    "@opensearch-project/opensearch": "^3.9.0",
    "@primer/octicons-react": "^19.28.1",
    "@primer/primitives": "^11.9.0",
    "@primer/react": "^38.27.0",
    "@vinext/cloudflare": "^1.3.0",
    "ai": "^7.0.157",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "recharts": "^3.10.1",
    "sst": "^3.19.3",
    "styled-components": "^6.4.2",
    "swr": "^2.5.1",
    "vinext": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.26",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "vite": "8.3.0",
    "wrangler": "^4.156.0"
